# Copy to .env and adjust.

# Training needs an NVIDIA GPU: include the GPU override by default
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Host ports (wakeword-trainer uses 8000). HTTPS carries a self-signed certificate and is what a phone
# in the LAN needs for the microphone.
PORT=8001
HTTPS_PORT=8444

# Host name or IP of this machine as seen from the phone (used in the phone link / QR code).
# Leave empty to use the address you open the app with. In WSL2 use the Windows LAN IP and forward the port
# (or enable networkingMode=mirrored in .wslconfig).
PUBLIC_HOST=

# Optional HTTP Basic auth (leave APP_PASSWORD empty to disable)
APP_USER=admin
APP_PASSWORD=

# Owner of files in ./data (run `id -u` / `id -g`)
PUID=1000
PGID=1000

# Finished training runs kept per voice
KEEP_JOBS=5
