# Copy to .env and adjust.

# Training needs an NVIDIA GPU: include the GPU override by default
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Host port (wakeword-trainer uses 8000)
PORT=8001

# Optional HTTP Basic auth (leave APP_PASSWORD empty to disable)
APP_USER=admin
APP_PASSWORD=

# Owner of files in ./data (run `id -u` / `id -g`)
PUID=1000
PGID=1000

# Finished training runs kept per voice
KEEP_JOBS=5
